# Creators API credentials. Never share or commit .env.
# US and Canada are separate Associates accounts, so each has its own credential:
#   US: affiliate-program.amazon.com > Tools > Creators API
#   CA: associates.amazon.ca         > Tools > Creators API
# Leave the CA lines empty until your Canada account is eligible; only US products will be fetched.
AMAZON_US_CLIENT_ID=
AMAZON_US_CLIENT_SECRET=
AMAZON_CA_CLIENT_ID=
AMAZON_CA_CLIENT_SECRET=
# Token endpoint for North America (same for amazon.com and amazon.ca)
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
